<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <!-- Keeps the CPU and Wi-Fi awake while streaming with the screen off. -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- Long episode downloads run as a data-sync foreground service (WorkManager). -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <!-- New-episode alerts (asked for only when the user turns them on). -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Lets Pod Wizard ask (with the system's own dialog) to be left out of battery saving, so
       background checks, downloads and transcription run on phones that stop them. -->
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

  <application>
    <!-- Lets Android Auto list Pod Wizard as a media app (no Google libraries involved). -->
    <meta-data
      android:name="com.google.android.gms.car.application"
      android:resource="@xml/automotive_app_desc" />
    <!-- Cover art for Android Auto and the notification (read-only; only covers from the
         library). Exported because the car reads it from its own app. -->
    <provider
      android:name="org.caster.playercore.ArtworkProvider"
      android:authorities="${applicationId}.artwork"
      android:exported="true"
      android:grantUriPermissions="true" />
    <!-- Exported so the system media controls, headsets and Android Auto can connect. -->
    <service
      android:name="org.caster.playercore.PlaybackService"
      android:exported="true"
      android:foregroundServiceType="mediaPlayback">
      <intent-filter>
        <action android:name="androidx.media3.session.MediaLibraryService" />
        <action android:name="androidx.media3.session.MediaSessionService" />
        <action android:name="android.media.browse.MediaBrowserService" />
      </intent-filter>
    </service>
    <!-- WorkManager's foreground service, declared with the type Android 14+ requires. -->
    <service
      android:name="androidx.work.impl.foreground.SystemForegroundService"
      android:foregroundServiceType="dataSync"
      tools:node="merge" />
  </application>
</manifest>
